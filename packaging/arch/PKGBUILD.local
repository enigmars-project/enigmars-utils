# Maintainer: RishiSpace <rishikesh.giridhar@outlook.com>
# Build from the parent git checkout (no network):
#   cd packaging/arch && makepkg -f -p PKGBUILD.local
pkgname=enigmars-utils
pkgver=1.3.0
pkgrel=1
pkgdesc="Qt landing hub: tweaks, packages, kernels, and Secure Boot for Linux"
arch=('any')
url="https://github.com/enigmars-project/enigmars-utils"
license=('GPL-3.0-or-later')
depends=('python' 'pyside6' 'polkit' 'qt6-base')
optdepends=(
  'sbctl: Secure Boot key enrollment'
  'ufw: firewall toggle'
  'plasma-discover: software center shortcut'
  'mpv: Cat Mode meow playback'
  'qt6-multimedia: in-app Cat Mode sound'
)
provides=('enigmars-util')
conflicts=('enigmars-util')
source=()
sha256sums=()

package() {
  cd "${startdir}/../.."
  DESTDIR="${pkgdir}" PREFIX=/usr ./scripts/install.sh
}
